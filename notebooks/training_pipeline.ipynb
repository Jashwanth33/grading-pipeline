{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["# ML Grading & Doubt Triage Pipeline - Training Notebook\n", "\n", "This notebook walks through the full training pipeline for both grading and doubt triage models."]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["import sys\n", "sys.path.insert(0, '..')\n", "\n", "import numpy as np\n", "import pandas as pd\n", "import matplotlib.pyplot as plt\n", "import seaborn as sns\n", "\n", "from scripts.generate_data import generate_grading_dataset, generate_doubt_dataset\n", "from backend.services.preprocess import GradingPreprocessor, DoubtPreprocessor\n", "from backend.services.features import GradingFeatureEngineer\n", "from backend.services.grading_pipeline import GradingModelTrainer\n", "from backend.services.triage_pipeline import NLPDoubtTriage\n", "\n", "plt.style.use('seaborn-v0_8-whitegrid')\n", "sns.set_palette('husl')\n", "print('All imports successful')"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 1. Generate Sample Data"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["grading_df = generate_grading_dataset(2000)\n", "doubt_df = generate_doubt_dataset(1500)\n", "\n", "print(f'Grading dataset: {grading_df.shape}')\n", "print(f'Grading columns: {grading_df.columns.tolist()}')\n", "grading_df.head()"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["print(f'Doubt dataset: {doubt_df.shape}')\n", "print(f'Columns: {doubt_df.columns.tolist()}')\n", "doubt_df.head()"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 2. Exploratory Data Analysis"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["fig, axes = plt.subplots(2, 5, figsize=(20, 8))\n", "for i, col in enumerate(grading_df.select_dtypes(include=[np.number]).columns):\n", "    ax = axes[i // 5, i % 5]\n", "    grading_df[col].hist(bins=30, ax=ax, edgecolor='black')\n", "    ax.set_title(col)\n", "plt.tight_layout()\n", "plt.show()"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["plt.figure(figsize=(10, 6))\n", "grading_df['quality_label'].value_counts().plot(kind='bar', edgecolor='black')\n", "plt.title('Quality Label Distribution')\n", "plt.ylabel('Count')\n", "plt.tight_layout()\n", "plt.show()"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n", "doubt_df['topic'].value_counts().plot(kind='bar', ax=axes[0], edgecolor='black')\n", "axes[0].set_title('Topic Distribution')\n", "doubt_df['urgency'].value_counts().plot(kind='bar', ax=axes[1], edgecolor='black')\n", "axes[1].set_title('Urgency Distribution')\n", "plt.tight_layout()\n", "plt.show()"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 3. Grading Pipeline Training"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["preprocessor = GradingPreprocessor()\n", "X_train, X_val, X_test, y_train, y_val, y_test, report = preprocessor.fit_transform(\n", "    grading_df, target_col='quality_label', handle_imbalance=True\n", ")\n", "print('Preprocessing report:')\n", "for k, v in report.items():\n", "    print(f'  {k}: {v}')"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["trainer = GradingModelTrainer()\n", "comparison = trainer.train_all_models(\n", "    X_train, y_train, X_val, y_val, cv_folds=5\n", ")\n", "\n", "comparison_df = pd.DataFrame(comparison).T\n", "print('\\nModel Comparison:')\n", "print(comparison_df[['accuracy', 'precision', 'recall', 'f1', 'roc_auc']].to_string())"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["test_results = trainer.evaluate_on_test(X_test, y_test)\n", "print('\\nTest Set Results:')\n", "print(f'  Accuracy:  {test_results[\"accuracy\"]:.4f}')\n", "print(f'  Precision: {test_results[\"precision\"]:.4f}')\n", "print(f'  Recall:    {test_results[\"recall\"]:.4f}')\n", "print(f'  F1:        {test_results[\"f1\"]:.4f}')\n", "if 'roc_auc' in test_results:\n", "    print(f'  ROC AUC:   {test_results[\"roc_auc\"]:.4f}')"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["cm = np.array(test_results['confusion_matrix'])\n", "plt.figure(figsize=(8, 6))\n", "sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',\n", "            xticklabels=trainer.feature_engineer.target_classes_,\n", "            yticklabels=trainer.feature_engineer.target_classes_)\n", "plt.title('Confusion Matrix')\n", "plt.xlabel('Predicted')\n", "plt.ylabel('Actual')\n", "plt.tight_layout()\n", "plt.show()"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["fi = trainer.compute_feature_importance()\n", "if not fi.empty:\n", "    plt.figure(figsize=(10, 6))\n", "    fi['mean_importance'].head(10).plot(kind='barh')\n", "    plt.title('Top 10 Feature Importance')\n", "    plt.xlabel('Importance')\n", "    plt.tight_layout()\n", "    plt.show()"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["shap_vals = trainer.compute_shap(X_test, max_samples=100)\n", "shap_summary = trainer.get_shap_summary()\n", "print('\\nSHAP Top Features:')\n", "for f in shap_summary.get('top_features', []):\n", "    print(f'  {f[\"name\"]}: {f[\"shap_value\"]:.4f}')"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["trainer.save_model()\n", "print('Grading model saved successfully')"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 4. Doubt Triage Training"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["doubt_preprocessor = DoubtPreprocessor()\n", "df_processed, topic_labels, urg_labels, t_report = doubt_preprocessor.fit_transform(doubt_df)\n", "print('Doubt preprocessing report:')\n", "for k, v in t_report.items():\n", "    print(f'  {k}: {v}')"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["triage = NLPDoubtTriage()\n", "topic_results = triage.train_topic_model(df_processed['question'], topic_labels)\n", "print('\\nTopic Model Comparison:')\n", "for name, r in topic_results.items():\n", "    print(f'  {name}: Acc={r[\"accuracy\"]:.4f}, F1={r[\"f1\"]:.4f}')"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["urgency_results = triage.train_urgency_model(df_processed['question'], urg_labels)\n", "print('\\nUrgency Model Comparison:')\n", "for name, r in urgency_results.items():\n", "    print(f'  {name}: Acc={r[\"accuracy\"]:.4f}, F1={r[\"f1\"]:.4f}')"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["optimal_thresh = triage.find_optimal_threshold(df_processed['question'], urg_labels)\n", "print(f'\\nOptimal threshold: {optimal_thresh:.2f}')\n", "print(f'Justification: {triage.threshold_analysis.get(\"justification\", \"\")}')"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["thresh_data = triage.threshold_analysis.get('results', [])\n", "if thresh_data:\n", "    thresh_df = pd.DataFrame(thresh_data)\n", "    fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n", "    axes[0].plot(thresh_df['threshold'], thresh_df['f1'], 'b-o', label='F1')\n", "    axes[0].axvline(x=optimal_thresh, color='r', linestyle='--', label=f'Optimal: {optimal_thresh:.2f}')\n", "    axes[0].set_xlabel('Threshold')\n", "    axes[0].set_ylabel('F1 Score')\n", "    axes[0].set_title('Threshold vs F1')\n", "    axes[0].legend()\n", "    axes[1].plot(thresh_df['threshold'], thresh_df['coverage'], 'g-o', label='Coverage')\n", "    axes[1].axvline(x=optimal_thresh, color='r', linestyle='--', label=f'Optimal: {optimal_thresh:.2f}')\n", "    axes[1].set_xlabel('Threshold')\n", "    axes[1].set_ylabel('Coverage')\n", "    axes[1].set_title('Threshold vs Coverage')\n", "    axes[1].legend()\n", "    plt.tight_layout()\n", "    plt.show()"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["sample_texts = pd.Series([\n", "    \"How do I use list comprehensions in Python?\",\n", "    \"I'm getting an error when trying to connect to the database\",\n", "    \"Can you explain recursion?\",\n", "])\n", "preds = triage.predict(sample_texts)\n", "for p in preds['predictions']:\n", "    print(f\"Q: {p['text'][:60]}...\")\n", "    print(f\"  Topic: {p['predicted_topic']} ({p['topic_confidence']:.2f})\")\n", "    print(f\"  Urgency: {p['predicted_urgency']} ({p['urgency_confidence']:.2f})\")\n", "    print(f\"  Route: {p['route']}\")\n", "    print()"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["triage.save_models()\n", "print('Triage models saved successfully')"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 5. Summary\n", "\n", "- **Grading**: Trained 4 models (RF, LR, LightGBM, XGBoost). Selected best by F1. Computed feature importance and SHAP.\n", "- **Doubt Triage**: Trained NB, LogReg, CountNB for topic and urgency. Found optimal confidence threshold for routing.\n", "- All models saved as pickle files for serving via FastAPI."]
  }
 ],
